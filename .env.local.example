# 本地测试环境变量模板 —— 复制为 .env.local 后按需修改（.env.local 已被 .gitignore 忽略）
# 用法见 LOCAL_TESTING.md

# ── 上游工作流 ──────────────────────────────────────────────
# 指向本地 mock 上游（pnpm mock）做确定性验收；注释掉即走真实上游
WORKFLOW_BASE_URL=http://localhost:5055
WORKFLOW_PROD_BASE_URL=http://localhost:5055

# 真实上游（默认值，无需配置即生效）：
# WORKFLOW_BASE_URL=https://yunyue-image2.coze.site
# WORKFLOW_PROD_BASE_URL=https://yunyue-image2.coze.site

# ── 逐张任务引擎参数（NEXT_PUBLIC_* 会被打进客户端包，改完必须重启 dev）──
# 单张超时阈值（毫秒）。生产默认 210000（210s）。
# 口径是「无进展时长」：距上一个上游进展事件超过该值才判卡死，ping 心跳不重置计时。
# 本地验收超时链路时可临时调小（例如 8000）以便在几秒内复现同一条代码路径。
# NEXT_PUBLIC_TASK_TIMEOUT_MS=210000

# 单张最大尝试次数（含首次）。默认 3 = 首次 + 2 次自动重试
# NEXT_PUBLIC_TASK_MAX_ATTEMPTS=3

# ── 用量账本（隐藏后台的数据源）──────────────────────────────
# 一行一条 JSON 的追加文件，默认 <cwd>/data/usage.jsonl。
# 容器部署时指到挂载卷，否则重新发布会丢历史。删掉该文件即清账。
# USAGE_LOG_PATH=/var/lib/joycloud/usage.jsonl

# 默认并发槽位。默认 3。填写值可超过 10，但调度器实际按 10 封顶。
# 注意：实测上游按账号近似串行，并发拉高不增加吞吐，只会拉长单条墙钟时间，
# 逼近 210s 阈值后会触发误判超时。详见 LOCAL_TESTING.md「并发与超时的实测关系」。
# NEXT_PUBLIC_TASK_CONCURRENCY=3
